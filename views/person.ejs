<%- include('header'); -%>
<%- include('navbar', { standaloneNavigation: true }); -%>
<main class="container standalone-page">
  <% if (locals.mapOrganization) { %>
    <p><a href="/?organization=<%= encodeURIComponent(mapOrganization) %>">&larr; Map</a></p>
  <% } else { %>
    <p><a href="/people">People</a></p>
  <% } %>
  <h1><%= person.name %></h1>
  <% if (person.title) { %><p><%= person.title %></p><% } %>
  <% if (person.url) { %><p><a href="<%= person.url %>">Website</a></p><% } %>
  <% if (person.socials.length) { %>
    <p class="social-links" aria-label="Social profiles">
      <% person.socials.forEach(function (social) {
        var iconPath = socialIcons[social.name.toLowerCase()]; %>
        <a href="<%= social.url %>" aria-label="<%= social.name %>" title="<%= social.name %>">
          <% if (iconPath) { %>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="<%= iconPath %>"></path></svg>
          <% } else { %><%= social.name %><% } %>
        </a>
      <% }); %>
    </p>
  <% } %>
  <% if (person.positions.length) { %>
    <h2>Positions</h2>
    <ul class="person-positions-list">
      <% person.positions.forEach(function (position) { %>
        <li>
          <% // The list item is a flex row, so the comma stays inside the title's item and the gap supplies the space. %>
          <% if (position.title) { %><span><strong><%= position.title %></strong><% if (position.organization_name || position.company) { %>,<% } %></span><% } %>
          <% var organizationName = position.organization_name || position.company;
            var formerly = position.company && position.organization_name && position.company !== position.organization_name;
            // The comma follows whatever ends the organization part, when a location comes next.
            var organizationComma = position.location ? ',' : ''; %>
          <% if (organizationName) { %><span><% if (position.organization_href) { %><a href="<%= position.organization_href %>"><%= organizationName %></a><% } else { %><%= organizationName %><% } %><% if (!formerly) { %><%= organizationComma %><% } %></span><% } %>
          <% if (formerly) { %>
            <span>(formerly recorded as <%= position.company %>)<%= organizationComma %></span>
          <% } %>
          <% if (position.location) {
            // "City, Region" links the city to the map at city level and the rest at country level.
            var comma = position.location.indexOf(',');
            var city = comma < 0 ? '' : position.location.slice(0, comma).trim();
            var region = comma < 0 ? '' : position.location.slice(comma + 1).trim(); %>
            <% if (city && region) { %>
              <span><a href="/?location=<%= encodeURIComponent(position.location) %>&amp;level=city" title="Show <%= city %> on the map"><%= city %></a>, <a href="/?location=<%= encodeURIComponent(region) %>&amp;level=country" title="Show <%= region %> on the map"><%= region %></a></span>
            <% } else { %><span><%= position.location %></span><% } %>
          <% } %>
          <% // Start/end dates win over the "as of" date, which is shown only when there are neither. %>
          <% if (position.start_date && position.end_date) { %><span><%= position.start_date %> to <%= position.end_date %></span>
          <% } else if (position.start_date) { %><span><%= position.start_date %></span>
          <% } else if (position.end_date) { %><span>to <%= position.end_date %></span>
          <% } else if (position.date) { %><span>as of <%= position.date %></span><% } %>
          <% // Same rule as the admin People list: only a position marked current is current. %>
          <span class="type-pill status-pill <%= position.current ? 'status-current' : 'status-alumni' %>"><%= position.current ? 'current' : 'alumni' %></span>
        </li>
      <% }); %>
    </ul>
  <% } %>
  <%- include('_comments', { comments: locals.comments, heading: 'Comments', level: 'h2', framed: true }); -%>
</main>
</body>
</html>
