<div class="organization-details">
<h1><%= organization.name %></h1>
<% if (organization.iot_organization === false) { %><p class="non-iot-note">Not listed on the IoT map.</p><% } %>
<%- include('organization-types'); -%>
<% if (typeof(organization.location) != "undefined") { %>
  <% if (typeof(organization.location[0]) != "undefined") { %>
    <input type="hidden" id="<%= organization.slug %>-lat" value=<%= organization.location[0].address.lat %>>
    <input type="hidden" id="<%= organization.slug %>-lng" value=<%= organization.location[0].address.lng %>>
  <% } %>
<% } %>
<% if (organization.getUrl()) {
  url = organization.getUrl(); %>
  <p><a href="<%= url %>" target="<%= organization.slug %>"><%= url %></a></p>
<% } %>

<% if (organization.getDateAdded()) { %>
  <p>Added: <%= organization.getDateAdded() %></p>
<% } %>

<% if (organization.history.founded_year) { %>
  <p>Founded: <%= organization.history.founded_year %></p>
<% } %>

<% var founderLinks = locals.founders || organization.history.founder.map(function (founder) {
  return { name: [founder.first_name, founder.last_name].filter(Boolean).join(' ') || founder.name || 'Unnamed founder',
    href: '', url: organization.checkUrl(founder.url) };
}); %>
<% if (founderLinks.length) { %><p>Founders:<% } %>
<% founderLinks.forEach(function (founder, i) { %>
  <% if (i) { %>, <% } %>
  <% if (founder.href) { %><a href="<%= founder.href %>"><%= founder.name %></a>
  <% } else if (founder.url) { %><a href="<%= founder.url %>" target="<%= organization.slug %>"><%= founder.name %></a>
  <% } else { %><%= founder.name %><% } %>
<% }); %>
<!--
<% if (organization.post.length) { %><p>Posted:<% } %>
<% for (i=0; i < organization.post.length; i++) {
  post = organization.post[ i ]; %>
  <% if (i) { %>, <% } %>
  <% if (post.url) { %><a href="<%= organization.checkUrl(post.url) %>" target="<%= organization.slug %>"><% } %>
    <%= post.service %><% if (post.url) { %></a><% } %>
  <% if (post.date) { %>(<%= organization.formatDate(post.date) %>) <% } %>
<% } %>
-->
<% if (organization.stock.ticker_symbol) { %>
  <p>Stock:
  <% if (organization.stock.url) { %>
    <a href="<%= organization.checkUrl(organization.stock.url) %>" target="<%= organization.slug %>"><% } %>
    <%= organization.stock.ticker_symbol %>
  <% if (organization.stock.url) { %></a><% } %>
  <% if (organization.stock.exchange) { %>(<%= organization.stock.exchange %>) <% } %>
<% } %>

<% if (organization.description) { %>
  <p><%= organization.description %></p>
<% } %>

<p class="social-links">
<% for (i=0; i < organization.social_network.length; i++) {
  socialNetwork = organization.social_network[ i ];
  if (!socialNetwork.url || !socialNetwork.url.trim()) { continue; }
  var iconPath = socialIcons[socialNetwork.service.trim().toLowerCase()];
    url = organization.checkUrl(socialNetwork.url);
    %><a href="<%= url %>" target="<%= organization.slug %>" aria-label="<%= socialNetwork.service %>" title="<%= socialNetwork.service %>">
    <% if (iconPath) { %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="<%= iconPath %>"></path></svg>
    <% } else { %><%= socialNetwork.service %><% } %>
    </a>
<% } %>
</p>

<% phone = organization.getPhone();
if (phone) { %><p>Phone: <%= phone %></p><% } %>

<% email = organization.getEmail();
if (email) {%><p>email: <a href="mailto:<%= email %>"><%= email %></a></p><% } %>

<% address = organization.getFirstLocation();
if (address) { %><p>Address: <%= address %></p><% } %>

<%- include('_comments', { comments: locals.comments, heading: 'Comments', level: 'h2' }); -%>

<% if (locals.people && people.length) { %>
  <section aria-label="People at this organization">
    <h2>People</h2>
    <ul>
      <% people.forEach(function (person) { %>
        <% person.positions.forEach(function (position) {
          var end = position.end_date || (position.current ? 'present' : '');
          var when = position.start_date && end ? position.start_date + ' to ' + end
            : position.start_date ? 'from ' + position.start_date
            : position.end_date ? 'until ' + position.end_date
            : position.current ? 'current' : '';
          var details = [position.title, when, position.date ? 'as of ' + position.date : ''].filter(Boolean); %>
          <li><% if (person.href) { %><a href="<%= person.href %>"><%= person.name %></a><% } else { %><%= person.name %><% } %><% details.forEach(function (detail) { %>, <%= detail %><% }); %></li>
        <% }); %>
      <% }); %>
    </ul>
  </section>
<% } %>
</div>

<div class="org-products"><%- include('product'); -%></div>