<nav class="navbar navbar-default navbar-static-top" role="navigation">
  <div class="container-fluid">

    <div class="navbar-header">
      <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
      <a class="navbar-brand site-wordmark" href="/">IoT Map</a>
    </div> <!-- navbar-header -->

    <div class="collapse navbar-collapse">
      <% if (locals.totals) { %>
      <div class="nav-totals" aria-label="Database totals">
        <% ['companies', 'people', 'products'].forEach(function (type) { %>
          <div class="nav-total total-<%= type %>">
            <strong><%= totals[type].toLocaleString('en-US') %></strong>
            <span><%= type === 'companies' ? 'Organizations' : type %></span>
          </div>
        <% }); %>
      </div>
      <% } %>
      <% if (locals.showSearch) { %>
      <form class="navbar-form navbar-right" role="search" id="nav-search-form">
        <button type="button" class="theme-toggle" id="theme-toggle" role="switch" aria-checked="false" aria-label="Dark mode">
          <span class="theme-track" aria-hidden="true"></span>
          <span class="theme-label">Light</span>
        </button>
        <input name="term" type="search" class="form-control" id="nav-search" placeholder="search term" autofocus>
      </form>
      <% } %>
    </div> <!-- collapse navbar-collapse -->

  </div> <!-- container-fluid -->
</nav> <!-- navbar -->