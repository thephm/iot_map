<% if (comments && comments.length) { %>
  <section class="public-comments<%= locals.framed ? ' public-comments-framed' : '' %>" aria-label="<%= heading %>">
    <<%= level %>><%= heading %></<%= level %>>
    <ul>
      <% comments.forEach(function (comment) { %>
        <li>
          <p class="public-comment-text"><%= comment.text %></p>
          <% if (comment.date) { %><time datetime="<%= comment.datetime %>" data-local-time><%= comment.date %> UTC</time><% } %>
        </li>
      <% }); %>
    </ul>
  </section>
<% } %>
