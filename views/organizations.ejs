<% organizations.forEach(function(organization) { %>

  <div class="panel panel-default organization-panel" id="<%= organization.slug %>-panel" name="<%= organization.slug %>" data-org-slug="<%= organization.slug %>">
    <div class="panel-heading">
      <% if (typeof(organization.location) != "undefined") { %>
        <% if (typeof(organization.location[0]) != "undefined") { %>
          <input type="hidden" id="organization.slug" value="<%= organization.slug %>">
          <input type="hidden" id="<%= organization.slug %>-lat" value="<%= organization.location[0].address.lat %>">
          <input type="hidden" id="<%= organization.slug %>-lng" value="<%= organization.location[0].address.lng %>">
        <% } %>
      <% } %>
      <a href="#" data-action="pin" data-slug="<%= organization.slug %>">
        <%= organization.name %>
      </a>
    </div>
    <div class="panel-body">
    <%- include('organization-types', { organization: organization }); -%>
    <% organization.product.forEach(function(product) { %>
    - <small><a href="#" data-action="product" data-slug="<%= product.slug %>"><%= product.name %></a></small><br>
    <% }) %>
    </div>
  </div>

<% }) %>
<% // Search also finds people; each opens their own page.
if (locals.people && people.length) { %>
  <div class="panel panel-default search-people">
    <div class="panel-heading">People</div>
    <div class="panel-body">
      <% people.forEach(function (person) {
        var position = person.positions[0];
        var detail = position ? [position.title, position.company].filter(Boolean).join(', ') : ''; %>
        <p><% if (person.href) { %><a href="<%= person.href %>"><%= person.name %></a><% } else { %><%= person.name %><% } %><% if (detail) { %><br><small><%= detail %></small><% } %></p>
      <% }); %>
    </div>
  </div>
<% } %>
